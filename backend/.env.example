# Copy to .env and replace the placeholder with a generated secret.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_JWT_SECRET=replace-with-a-random-secret
APP_JWT_EXPIRE_MINUTES=480

# Lab folders on the workstation (optional). Leave them commented out when the
# folders are not available: an empty value would point to the current folder.
# The three variables may point to the same folder.
# APP_VIDEO_DIR=/home/<user>/nas_public/tAlgae_exp/
# APP_TRAJECTORIES_DIR=/home/<user>/nas_public/tAlgae_exp/
# APP_ILLUMINATION_DIR=/home/<user>/nas_public/tAlgae_exp/
